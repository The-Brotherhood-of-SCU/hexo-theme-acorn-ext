<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %>" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <% if (index && (theme.auto_fold ||post.excerpt)){ %>
  <div class="card article-card card-accent h-100">
    <%- partial('post/gallery') %>
    <div class="card-body d-flex flex-column">
      <div class="article-card-meta">
        <%- partial('post/author', {class_name: 'article-card-author'}) %>
        <%- partial('post/date', {class_name: 'article-card-date', date_format: null}) %>
      </div>
      <%- partial('post/title', {class_name: 'article-card-title line-clamp line-clamp-2'}) %>
      <div class="article-card-excerpt line-clamp line-clamp-3"><%- post.excerpt||post.content %></div>
      <% if (theme.excerpt_link){ %>
      <div class="article-card-footer">
        <a class="card-link-more" href="<%- url_for(post.path) %>#more"><%= theme.excerpt_link %><span class="card-link-arrow">&rarr;</span></a>
      </div>
      <% } %>
    </div>
  </div>
  <% } else { %>
  <% if (is_post()) { %>
  <div class="article-cover mb-5">
    <%- partial('post/gallery') %>
  </div>
  <% } %>
  <div class="article-inner">
    <% if (post.link || post.title){ %>
    <header class="article-header">
      <% if (!is_page()) { %>
      <%- partial('post/title', {class_name: 'article-title'}) %>
      <div class="article-meta">
        <% if (post.author){ %>
        <span class="article-author" itemprop="author" itemscope itemtype="https://schema.org/Person">
          <span class="article-author-name" itemprop="name"><%= post.author %></span>
        </span>
        <% } %>
        <%- partial('post/date', {class_name: 'article-date', date_format: null}) %>
        <%- partial('post/category') %>
      </div>
      <% } %>
    </header>
    <% } %>
    <div class="article-entry js-toc-content" itemprop="articleBody">
      <%- post.content %>
    </div>
    <!-- <ol class="js-toc"></ol>  -->
    <!-- TODO:目录无法显示 by tocbot -->
    <footer class="article-footer">
      <%- partial('post/tag') %>
    </footer>
  </div>
  <% } %>
  <% if (!index){ %>
    <%- partial('post/nav') %>
    <%- partial('comments') %>
  <% } %>
</article>