<div class="page-heading<% if (page.cn_title) { %> internal-heading<% } %>">
  <!-- page-type-title -->
  <% if (!is_post()) { %>
    <%- partial('title') %>
  <% } %>
  <!-- page-type-slogan -->
  <% if (page.cn_title) { %>
  <h5 class="slogan font-w-lighter text-gray"><%= page.cn_title %></h5>
  <% } else { %>
  <h5 class="slogan font-w-lighter text-gray">
    <% if (is_archive()) { %>
    <%- theme.slogan.archives %>
    <% } else if (is_page()) { %>
    <%- theme.slogan.pages %>
    <% } else {%>
    <%- theme.slogan.posts %>
    <% } %>
  </h5>
  <% } %>
</div>
