<div class="row">
  <% for (var item in site.data.open_projects){%>
    <div class="col-4">
      <div class="card rounded bg-white h-100">
        <a href="<%=url_for(site.data.open_projects[item]['link']) %>" style="display:block;height:18rem;overflow:hidden;">
          <img class="card-img lazyload" data-src="<%=url_for(site.data.open_projects[item]['cover']) %>" alt="<%=site.data.open_projects[item]['name'] %>" style="width:100%;height:100%;object-fit:cover;">
        </a>
        <div class="card-body px-4">
          <h5 class="card-title line-clamp line-clamp-1" style="margin-bottom: 0rem;">
            <a href="<%=url_for(site.data.open_projects[item]['link']) %>">
              <%=site.data.open_projects[item]['name'] %>
            </a>
          </h5>
          <% if (site.data.open_projects[item]['en_name']) { %>
            <h6 class="card-subtitle text-uppercase line-clamp line-clamp-1" style="font-size: 1.4rem; margin: 0 0 0.25rem 0; color: #8e959b;">
              <%=site.data.open_projects[item]['en_name'] %>
            </h6>
          <% } %>
          <hr class="hr">
          <p class="card-text text-gray line-clamp line-clamp-2"><%=site.data.open_projects[item]['description'] %></p>
        </div>
      </div>
    </div>
  <%} %>
</div>