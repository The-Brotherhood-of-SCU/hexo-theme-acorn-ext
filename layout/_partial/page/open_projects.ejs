<div class="row">
  <% for (var item in site.data.open_projects){%>
    <div class="col-4">
      <div class="card project-card h-100">
        <a class="project-cover" href="<%=url_for(site.data.open_projects[item]['link']) %>">
          <img class="card-img lazyload" data-src="<%=url_for(site.data.open_projects[item]['cover']) %>" alt="<%=site.data.open_projects[item]['name'] %>">
        </a>
        <div class="card-body d-flex flex-column">
          <h5 class="project-title line-clamp line-clamp-1">
            <a href="<%=url_for(site.data.open_projects[item]['link']) %>"><%=site.data.open_projects[item]['name'] %></a>
          </h5>
          <% if (site.data.open_projects[item]['en_name']) { %>
            <span class="project-en line-clamp line-clamp-1"><%=site.data.open_projects[item]['en_name'] %></span>
          <% } %>
          <p class="project-desc line-clamp line-clamp-2"><%=site.data.open_projects[item]['description'] %></p>
          <div class="project-footer">
            <a class="card-link-more" href="<%=url_for(site.data.open_projects[item]['link']) %>">查看项目<span class="card-link-arrow">&rarr;</span></a>
          </div>
        </div>
      </div>
    </div>
  <%} %>
</div>