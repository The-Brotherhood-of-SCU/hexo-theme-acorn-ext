<div class="col-3">
  <a target="_blank" rel="noopener" href="<%= url_for(plugin.link) %>" class="internal-card-link">
    <div class="card rounded internal-card">
      <div class="internal-card-icon">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"></polyline>
          <polyline points="8 6 2 12 8 18"></polyline>
        </svg>
      </div>
      <div class="card-body">
        <h5 class="card-title line-clamp line-clamp-1"><%= plugin.name %></h5>
        <small class="internal-card-en"><%= plugin.en_name %></small>
        <hr class="hr">
        <div class="card-text text-gray line-clamp line-clamp-3"><%= plugin.description %></div>
      </div>
      <div class="internal-card-footer">
        <span>View on GitHub</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </div>
    </div>
  </a>
</div>
