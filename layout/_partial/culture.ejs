<!-- 
  Data Files: source/_data/culture.yml
-->
<div class="row">
  <% for (var item in site.data.culture){%>
    <div class="col-4">
      <div class="culture-card text-center">
        <div class="culture-icon-wrap">
          <img src="<%=url_for(site.data.culture[item]['cover']) %>" alt="<%=site.data.culture[item]['name'] %>" width="<%=site.data.culture[item]['cover_size'] %>" height="<%=site.data.culture[item]['cover_size'] %>">
        </div>
        <h4 class="culture-title"><%=site.data.culture[item]['name'] %></h4>
        <p class="culture-desc"><%=site.data.culture[item]['description'] %></p>
      </div>
    </div>
  <%} %>
</div>