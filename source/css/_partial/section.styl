//
// Section
//
.section
  .section-heading
    position: relative
    padding-bottom: spacer * 1.4
    h3
      font-size: 3rem
      font-weight: 700
      letter-spacing: -.02em
      color: gray-900
    p
      font-size: 1.5rem
      letter-spacing: .01em
      margin-bottom: 0
    &::after
      content: ''
      position: absolute
      center-x()
      bottom: 0
      width: 4.8rem
      height: .35rem
      background: brand-gradient
      border-radius: .35rem
    // 进入视口后渐变条从中心展开（无 JS 时保持常显）
    &.is-revealed::after
      animation: heading-bar-grow .7s card-ease .3s both

@keyframes heading-bar-grow
  from
    transform: translateX(-50%) scaleX(0)
  to
    transform: translateX(-50%) scaleX(1)

// Culture cards
.culture-card
  padding: 3.4rem 2.4rem
  border-radius: card-radius
  background: white
  border: border-width solid card-border-color
  box-shadow: card-shadow-rest
  transition: card-transition
  height: 100%
  &:hover
    transform: translateY(card-lift)
    box-shadow: card-shadow-hover
    border-color: card-border-hover-c
    .culture-icon-wrap
      background: primary-color
      box-shadow: 0 10px 24px rgba(30, 144, 255, .32)
      transform: translateY(-2px)
      img
        filter: brightness(0) invert(1)

  .culture-icon-wrap
    width: 7.2rem
    height: 7.2rem
    border-radius: 1.8rem
    background: rgba(30, 144, 255, .08)
    display: flex
    align-items: center
    justify-content: center
    margin: 0 auto 2.2rem
    transition: card-transition

  .culture-title
    font-size: 1.9rem
    font-weight: 600
    letter-spacing: -.01em
    color: gray-900
    margin-bottom: .8rem

  .culture-desc
    font-size: 1.4rem
    color: gray-color
    line-height: 1.7
    margin: 0
