// Hero
.hero
  background-color: var(--bg)

.hero-figure
  position: relative
  z-index: 0
  height: 90vh
  margin: 0
  padding: 0
  overflow: hidden
  &::before
    content: ''
    position absolute
    z-index: 1
    top 0
    right 0
    bottom 0
    left 0
    background: linear-gradient(135deg, rgba(0,10,30,.75) 0%, rgba(0,22,43,.55) 60%, rgba(0,22,43,.3) 100%)
  figcaption
    position absolute
    z-index: 2
    center()
    display block
    color light-color
    text-align center
    font-size large
    width: 100%
    padding: 0 2rem

.figure-inset
  .hero-badge
    display: inline-block
    padding: .5rem 1.6rem
    border: 1px solid rgba(255,255,255,.4)
    border-radius: 2rem
    font-size: 1.2rem
    letter-spacing: .15em
    text-transform: uppercase
    color: rgba(255,255,255,.8)
    margin-bottom: 2rem
    backdrop-filter: blur(4px)
    background: rgba(255,255,255,.08)
    animation: rise-in .8s card-ease .1s both

  .hero-title
    font-size: 5.6rem
    font-weight: 700
    letter-spacing: -.02em
    line-height: 1.1
    margin-bottom: 1.6rem
    text-shadow: 0 2px 20px rgba(0,0,0,.3)
    animation: rise-in .8s card-ease .22s both
    @media screen and (max-width: 768px)
      font-size: 3.6rem

  .hero-subtitle
    font-size: 1.8rem
    color: rgba(255,255,255,.75)
    margin-bottom: 3.2rem
    font-weight: 300
    letter-spacing: .02em
    animation: rise-in .8s card-ease .34s both

  .hero-actions
    display: flex
    gap: 1.2rem
    justify-content: center
    flex-wrap: wrap
    animation: rise-in .8s card-ease .46s both

  .btn-hero-primary
    display: inline-block
    padding: 1.2rem 3rem
    background: primary-color
    color: white
    border-radius: .6rem
    font-size: 1.5rem
    font-weight: 500
    text-decoration: none
    transition: transition-base
    border: 2px solid primary-color
    &:hover
      background: lighten(primary-color, 10%)
      border-color: lighten(primary-color, 10%)
      transform: translateY(-2px)
      box-shadow: 0 8px 24px rgba(30,144,255,.4)

  .btn-hero-outline
    display: inline-block
    padding: 1.2rem 3rem
    background: rgba(255,255,255,.1)
    color: white
    border-radius: .6rem
    font-size: 1.5rem
    font-weight: 500
    text-decoration: none
    transition: transition-base
    border: 2px solid rgba(255,255,255,.4)
    backdrop-filter: blur(4px)
    &:hover
      background: rgba(255,255,255,.2)
      border-color: rgba(255,255,255,.7)
      transform: translateY(-2px)

.hero-figure-img
  position: absolute
  center()
  min-width: 100%
  min-height: 100%
  object-fit: cover
  transform-origin: center center
  will-change: transform
  // 持续缓慢的 Ken Burns 缩放，让首屏背景始终有呼吸感
  animation: hero-kenburns 26s ease-in-out infinite alternate

@keyframes hero-kenburns
  from
    transform: translate(-50%, -50%) scale(1)
  to
    transform: translate(-50%, -50%) scale(1.08)
