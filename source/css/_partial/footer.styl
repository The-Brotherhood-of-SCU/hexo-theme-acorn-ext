//
// Footer
//
.footer
  position: relative
  background: linear-gradient(180deg, #1a1f2e 0%, #212529 100%)
  color: gray-color
  a
    color: gray-color
    transition: transition-base
    &:hover
      color: light-color
  .footer-brand
    opacity: .7
    transition: transition-base
    &:hover
      opacity: 1
