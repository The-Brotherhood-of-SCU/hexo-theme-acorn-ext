//
// Card
//
.card
  position: relative
  overflow: hidden
  transition: transition-base
  border-radius: 1rem
  .card-img
    display: block
    max-width: 100%
    transition(transition-base)
  .card-body,
  .card-header,
  .card-footer
    padding: spacer * 2
  .card-body
    .archive-article-title + time
      display: inline-block
      margin-bottom: spacer
  .card-text,
  .card-text > p
    min-height: font-line-height * font-size-base * 2
    margin-bottom: 0
  &:hover
    box-shadow: 0 12px 32px rgba(0,0,0,.1)
    transform: translateY(-4px)
    .card-img
      opacity: .85
      transform: scale(1.03)

.shadow-hover
  transition: transition-base
  &:hover
    box-shadow: 0 8px 24px rgba(0,0,0,.12)
    transform: translateY(-2px)

.rounded-spacer
  border-radius: 1.2rem
