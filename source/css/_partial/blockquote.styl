//
// blockquote
//
.blockquote
  position: relative
  margin-right: auto
  margin-left: auto
  @media media-sm
    width: 80%
  .blockquote-body
    position: relative
    padding: spacer spacer * 5
    p
      font-size: 2rem
      line-height: 1.85
      font-weight: 400
      letter-spacing: .01em
      color: gray-800
      margin-bottom: 0
    &::before
      position: absolute
      top: 0
      left: 0
      content: url(/images/icons/quotes_before.svg)
    &::after
      position absolute
      right 0
      bottom 0
      content: url(/images/icons/quotes_after.svg)
  .blockquote-footer
    display: block
    font-style: italic
    font-size: 1.4rem
    letter-spacing: .02em
    color: gray-500
    margin-top: 1.4rem
    &::before
      content: '—'
      margin-right: .6rem
      display: inline-block
      width: 1.6rem
