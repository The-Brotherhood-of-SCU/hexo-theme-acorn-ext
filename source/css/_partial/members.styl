//
// Members page
//
.members-grid
  display: grid
  grid-template-columns: repeat(2, 1fr)
  gap: 2.4rem
  @media screen and (min-width: 768px)
    grid-template-columns: repeat(3, 1fr)
  @media screen and (min-width: 992px)
    grid-template-columns: repeat(4, 1fr)

.member-card
  background: white
  border-radius: 1.6rem
  border: 1px solid rgba(0,0,0,.06)
  overflow: hidden
  transition: transition-base
  text-align: center
  &:hover
    transform: translateY(-6px)
    box-shadow: 0 16px 40px rgba(0,0,0,.1)
    border-color: rgba(30,144,255,.2)
    .member-avatar
      transform: scale(1.05)
    .member-avatar-overlay
      opacity: 1

.member-avatar-wrap
  display: block
  position: relative
  overflow: hidden
  aspect-ratio: 1
  background: gray-200

.member-avatar
  width: 100%
  height: 100%
  object-fit: cover
  transition: transform .4s ease

.member-avatar-overlay
  position: absolute
  inset: 0
  background: rgba(30,144,255,.7)
  display: flex
  align-items: center
  justify-content: center
  opacity: 0
  transition: transition-base

.member-info
  padding: 1.6rem 1.6rem 2rem

.member-name
  font-size: 1.6rem
  font-weight: 600
  margin-bottom: .4rem
  color: dark-color

.member-role
  display: inline-block
  font-size: 1.1rem
  font-weight: 500
  color: primary-color
  background: rgba(30,144,255,.08)
  padding: .2rem .8rem
  border-radius: 2rem
  letter-spacing: .04em
  text-transform: uppercase
  margin-bottom: 1rem

.member-bio
  font-size: 1.3rem
  color: gray-color
  line-height: 1.5
  margin: .8rem 0
  min-height: 0

.member-github
  display: inline-block
  font-size: 1.2rem
  color: gray-color
  text-decoration: none
  transition: transition-base
  &:hover
    color: primary-color
