// Index style
//
.index-about
  position: relative
  z-index: 1
  background-size: cover
  background-position: center
  background-image: url(/images/banner/city_scene.avif)
  &::before
    content: ''
    position: absolute
    z-index: 2
    top: 0
    right: 0
    bottom: 0
    left: 0
    background-image: linear-gradient(180deg, #00b5ef, #3388ff)
    opacity: .9
  .container
    z-index: 3


// Internal Projects Card
//
.internal-card-link
  text-decoration: none
  color: inherit
  display: block
  height: 100%

.internal-card
  padding: spacer * 2
  height: 100%
  &:hover
    .internal-card-icon
      background: vis-primary-color
      color: #fff
      box-shadow: 0 8px 20px rgba(30, 144, 255, .32)
      transform: translateY(-2px)
    .internal-card-footer
      color: vis-primary-color

.internal-card-icon
  width: 5.6rem
  height: 5.6rem
  border-radius: 1.4rem
  background: rgba(30, 144, 255, 0.08)
  color: vis-primary-color
  display: flex
  align-items: center
  justify-content: center
  margin-bottom: spacer * 1.5
  transition: card-transition

.internal-card .card-body
  padding: 0
  flex-grow: 1

.internal-card .card-title
  font-size: $h5-font-size
  font-weight: 600
  margin-bottom: spacer * 0.5
  color: gray-900

.internal-card-en
  color: gray-500
  font-size: 1.2rem
  letter-spacing: 0.04em
  text-transform: uppercase
  display: block
  margin-bottom: spacer

.internal-card .hr
  margin: spacer 0

.internal-card .card-text
  font-size: 1.4rem
  line-height: 1.6

.internal-card-footer
  display: flex
  align-items: center
  gap: 0.5rem
  margin-top: spacer * 1.5
  font-size: 1.3rem
  color: gray-500
  transition: color .3s card-ease


// Internal page heading: always stack vertically
//
.internal-heading.page-heading
  @media media-sm
    flex-direction: column
    align-items: flex-start
    justify-content: flex-start
